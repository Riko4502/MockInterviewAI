# Global environment variables for MockInterviewAI
NODE_ENV=development

# CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie Configuration 
# todo убрать дублирование
JWT_SECRET=super-secret-jwt-key-change-in-production-12345
ACCESS_TOKEN_COOKIE_NAME=access_token
JWT_ACCESS_COOKIE_NAME=access_token
JWT_REFRESH_COOKIE_NAME=refresh_token
REFRESH_TOKEN_COOKIE_NAME=refresh_token

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=mock-interview-ai
JWT_AUDIENCE=api
REFRESH_TOKEN_HASH_SECRET=change-me-refresh-hash-secret-at-least-32-chars


# Logging Configuration (debug, info, warn, error)
LOG_LEVEL=debug

# Redis Configuration (Access/Refresh Token Blacklist & Active Sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-password-local
REDIS_DB=0
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# RabbitMQ Message Broker Configuration
# ВНИМАНИЕ: Для production не используйте пользователя guest (RabbitMQ блокирует удаленные подключения guest).
# Учетные данные внутри RABBITMQ_URL обязаны быть percent-encoded (RFC 3986), если пароль содержит спецсимволы.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=mock_interview
RABBITMQ_PASSWORD=mock_interview_pass
RABBITMQ_URL=amqp://mock_interview:mock_interview_pass@localhost:5672

# Realtime Service
# ALLOWED_ORIGINS задается один раз выше (секция CORS origins): повторное
# объявление здесь перетирало белый список значением "*", из-за чего браузер
# отбрасывал ответы на запросы с cookie.
REALTIME_PORT=8080
REALTIME_HOST=0.0.0.0
MAX_CONNECTIONS=10000
MAX_ROOM_CLIENTS=20

# API Service
API_PORT=3001
API_PREFIX=/api/v1

# Next.js Web App
NEXT_PUBLIC_REALTIME_WS_URL=ws://localhost:8080

# LiveKit WebRTC Video/Audio Streaming
# Join-токен выдаётся через POST /api/v1/realtime/media-token (см. apps/api/docs/spec-livekit-media.md)
# LIVEKIT_API_SECRET обязан быть >= 32 символов (требование livekit-server).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=dev-local-secret-change-me-0123456789
LIVEKIT_TOKEN_TTL_SECONDS=1800
# Webhook верификация (realtime, Go): совпадает с api_key/api_secret секции webhook контейнера livekit
LIVEKIT_WEBHOOK_API_KEY=devkey
LIVEKIT_WEBHOOK_API_SECRET=dev-local-secret-change-me-0123456789
# UDP-диапазон медиапотоков (WebRTC). Дефолт вне исключённых Hyper-V/WSL2
# портов Windows 50000-50478. Если на машине заблокирован и он — переопределить:
# netsh interface ipv4 show excludedportrange protocol=udp
LIVEKIT_UDP_PORT_START=60000
LIVEKIT_UDP_PORT_END=60018

# S3 / MinIO Object Storage Configuration
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=mock-interview-storage
S3_PUBLIC_URL=http://localhost:9000/mock-interview-storage
S3_FORCE_PATH_STYLE=true

# OpenAPI
OPENAPI_OUTPUT_DIR=./apps/api/openapi

# Telegram Bot (apps/telegram-bot <-> apps/api)
# Сервисный ключ для X-Internal-Service-Key (мин. 32 симв.), общий для бота и API.
INTERNAL_SERVICE_KEY=change-me-internal-service-secret-key-min-32-chars
TELEGRAM_BOT_USERNAME=MockInterviewBot
TELEGRAM_LINK_TTL_SECONDS=900
# Для бота: apps/telegram-bot/.env — см. apps/telegram-bot/.env.example
# TELEGRAM_BOT_TOKEN=change-me-from-botfather
# API_INTERNAL_URL=http://localhost:3001/api/v1
# WEB_APP_URL=http://localhost:3000
# TELEGRAM_WEBHOOK_URL= (пусто = Long Polling в dev)
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_WEBHOOK_PORT=8443

# --- Sentry (packages/observability) ---
# При пустом SENTRY_DSN SDK не инициализируется ни в одном сервисе (guard).
# Для client-бандлов (web, landing) DSN встраивается только через префикс NEXT_PUBLIC_.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# AUTH_TOKEN нужен только на сборке для загрузки source maps (сборка без него работает).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=mockinterviewai
SENTRY_PROJECT=
# окружение, переезжающее в release/теги: development | staging | production
SENTRY_ENVIRONMENT=development
# доля трафика с distributed tracing (0.0 - 1.0)
SENTRY_TRACES_SAMPLE_RATE=0.2
# публичные переменные для browser bundle (web, landing)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# --- Grafana (infra, шаги 10-11 PLAN) ---
GRAFANA_ADMIN_USER=admin
# Обязателен в prod: docker-compose.prod.yml падает без значения (fail-closed).
# В CI/CD прокидывается через secrets.GRAFANA_ADMIN_PASSWORD (deploy-server.yml).
GRAFANA_ADMIN_PASSWORD=
# Версия Sentry Datasource plugin для Grafana (пнится в GF_INSTALL_PLUGINS,
# чтобы установка не зависела от plugin registry при каждом старте контейнера).
SENTRY_DATASOURCE_VERSION=2.2.6
