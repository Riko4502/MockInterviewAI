{
  "name": "@packages/i18n",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    },
    "./locales/*": "./src/locales/*"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --no-errors-on-unmatched",
    "format": "biome format --write --no-errors-on-unmatched",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@rslib/core": "^0.23.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
