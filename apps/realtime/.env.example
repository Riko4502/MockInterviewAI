# Realtime Service specific overrides (optional)

PORT=8080
HOST=0.0.0.0
ENV=development
LOG_LEVEL=debug
SHUTDOWN_TIMEOUT_SECONDS=10
READ_TIMEOUT_SECONDS=15
WRITE_TIMEOUT_SECONDS=15
MAX_CONNECTIONS=10000
MAX_ROOM_CLIENTS=20

# --- Server-Sent Events (глобальный поток уведомлений /sse/notifications) ---

# Период heartbeat-комментариев ": ping <ts>" (сек)
SSE_HEARTBEAT_SECONDS=15
# Длительность блокирующего XREAD BLOCK по стриму пользователя (сек)
SSE_STREAM_BLOCK_SECONDS=15
# Сколько времени буфер медленного клиента может оставаться полным до разрыва (сек)
SSE_SLOW_CONSUMER_GRACE_SECONDS=30
# Емкость кольцевого буфера одного SSE-соединения (событий)
SSE_CLIENT_BUFFER_SIZE=128
# Лимит одновременных SSE-соединений на пользователя (вкладок)
SSE_MAX_CONNECTIONS_PER_USER=5
# Лимит одновременных SSE-соединений с одного IP-адреса
SSE_MAX_CONNECTIONS_PER_IP=20
# Максимум событий, отдаваемых при восстановлении по Last-Event-ID
SSE_REPLAY_COUNT=20
# Интервал переподключения, рекомендуемый клиенту в поле retry (мс)
SSE_RETRY_MS=3000

# Определять IP клиента по X-Forwarded-For / X-Real-IP.
# Включать ТОЛЬКО за доверенным обратным прокси: иначе лимит на IP обходится подделкой заголовка.
TRUST_PROXY_HEADERS=false

# Размер пула соединений Redis. Блокирующий XREAD удерживает одно соединение
# на каждого пользователя с активным SSE-потоком.
REDIS_POOL_SIZE=100
