{
  "name": "@apps/realtime",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "go run ./cmd/server",
    "dev:docker": "docker compose -f ../../docker-compose.yml --env-file ../../.env --profile realtime up -d --build realtime",
    "docker:logs": "docker compose -f ../../docker-compose.yml --env-file ../../.env --profile realtime logs -f realtime",
    "docker:down": "docker compose -f ../../docker-compose.yml --env-file ../../.env --profile realtime stop realtime",
    "build": "go build -o dist/server ./cmd/server",
    "start": "go run ./cmd/server",
    "test": "go test -v ./...",
    "lint": "go vet ./..."
  }
}
