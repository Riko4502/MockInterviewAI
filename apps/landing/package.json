{
  "name": "landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome check --no-errors-on-unmatched",
    "format": "biome format --write --no-errors-on-unmatched",
    "test": "vitest run",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "vercel-ignore": "bash ../../scripts/vercel-ignore-landing.sh"
  },
  "dependencies": {
    "@packages/tailwind-config": "workspace:*",
    "@packages/ui": "workspace:*",
    "astro": "^7.2.4",
    "tailwindcss": "^4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/vite": "^4",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
