{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 4321",
    "build": "next build",
    "start": "next start --port 4321",
    "check": "tsc --noEmit",
    "lint": "biome check --no-errors-on-unmatched",
    "format": "biome format --write --no-errors-on-unmatched",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "vercel-ignore": "bash ../../scripts/vercel-ignore-landing.sh"
  },
  "dependencies": {
    "@packages/i18n": "workspace:*",
    "@packages/icons": "workspace:*",
    "@packages/tailwind-config": "workspace:*",
    "@packages/ui": "workspace:*",
    "@packages/utils": "workspace:*",
    "i18next": "^26.4.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
