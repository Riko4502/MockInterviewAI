---
// LandingPage.astro
import '@/styles/globals.css';
import type { Lang } from '@/i18n/ui';
import Navbar from '@/components/Navbar.astro';
import Hero from '@/components/Hero.astro';
import HowItWorks from '@/components/HowItWorks.astro';
import Features from '@/components/Features.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DEVSYNC | Technical Interviews, Built for Developers</title>
    <meta name="description" content="Conduct realistic technical mock interviews powered by AI. Real-time feedback, code evaluation, and performance analytics to land your dream role." />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#090a10] text-[#f8fafc] font-sans antialiased selection:bg-violet-500 selection:text-white min-h-screen flex flex-col justify-between">
    
    <!-- Top Navigation -->
    <Navbar lang={lang} />

    <!-- Main Content -->
    <main class="flex-grow">
      <Hero lang={lang} />
      <HowItWorks lang={lang} />
      <Features lang={lang} />
    </main>

    <!-- Footer -->
    <Footer lang={lang} />

  </body>
</html>
