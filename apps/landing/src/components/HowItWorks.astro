---
// HowItWorks.astro
import { type Lang, useTranslations } from "@/i18n/ui";
import StepAiInterview from "./how-it-works/StepAiInterview.astro";
import StepLiveCoding from "./how-it-works/StepLiveCoding.astro";
import StepScorecard from "./how-it-works/StepScorecard.astro";
import StepTrackSelect from "./how-it-works/StepTrackSelect.astro";

interface Props {
  lang?: Lang;
}

const { lang = "ru" } = Astro.props;
const t = useTranslations(lang);
---

<section id="how-it-works" class="relative py-24 md:py-36 border-t border-white/10 bg-[#07080e] overflow-hidden">
  <!-- Ambient Glow Effects -->
  <div class="absolute top-1/3 left-0 w-[500px] h-[500px] bg-violet-600/10 blur-[150px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-1/4 right-0 w-[500px] h-[500px] bg-indigo-600/10 blur-[150px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-20 md:mb-28">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/30 text-violet-300 text-xs font-semibold tracking-wider uppercase mb-4 shadow-sm shadow-violet-500/20">
        {t('howItWorks.badge')}
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white mb-4">
        {t('howItWorks.title')}
      </h2>
      <p class="text-base sm:text-lg text-slate-300">
        {t('howItWorks.subtitle')}
      </p>
    </div>

    <!-- Steps Stack -->
    <div class="space-y-24 md:space-y-32 relative">
      <StepTrackSelect lang={lang} />
      <StepAiInterview lang={lang} />
      <StepLiveCoding lang={lang} />
      <StepScorecard lang={lang} />
    </div>

  </div>
</section>
