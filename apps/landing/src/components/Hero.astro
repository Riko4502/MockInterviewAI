---
import { getRegisterUrl } from "@/config/navigation";
// Hero.astro
import { type Lang, useTranslations } from "@/i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "ru" } = Astro.props;
const t = useTranslations(lang);
const registerUrl = getRegisterUrl();
---

<section class="relative pt-12 pb-20 md:pt-24 md:pb-36 overflow-hidden bg-grid-pattern">
  <!-- Glowing Background Orbs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[400px] bg-violet-600/20 blur-[140px] rounded-full pointer-events-none -z-10 animate-pulse-slow"></div>
  <div class="absolute top-1/3 left-1/4 w-[450px] h-[350px] bg-indigo-500/15 blur-[120px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-1/2 right-1/4 w-[350px] h-[250px] bg-purple-600/15 blur-[110px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      
      <!-- Left Hero Content (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Pill Badge with glow -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/30 text-violet-300 text-xs font-semibold tracking-wider uppercase mb-6 shadow-sm shadow-violet-500/20 hover:border-violet-500/50 transition-colors">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{t('hero.badge')}</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.12] mb-6">
          {t('hero.title1')} <br class="hidden sm:inline" />
          <span class="text-gradient-purple">{t('hero.title2')}</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-slate-300 font-normal leading-relaxed mb-8 max-w-xl">
          {t('hero.subtitle')}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-12">
          <a
            href={registerUrl}
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 text-base font-semibold text-white bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 rounded-full px-8 py-3.5 shadow-xl shadow-violet-600/30 hover:shadow-violet-500/50 hover:scale-[1.02] active:scale-[0.98] transition-all"
          >
            <span>{t('hero.ctaStart')}</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a
            href="#how-it-works"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-base font-semibold text-slate-200 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 rounded-full px-7 py-3.5 backdrop-blur-md transition-all shadow-sm"
          >
            {t('hero.ctaExplore')}
          </a>
        </div>

        <!-- Metrics Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-6 border-t border-white/10 w-full max-w-2xl">
          <div class="space-y-0.5">
            <div class="text-2xl sm:text-3xl font-extrabold text-white font-mono">{t('hero.metric1Value')}</div>
            <div class="text-xs font-medium text-slate-400">{t('hero.metric1Label')}</div>
          </div>
          <div class="space-y-0.5">
            <div class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono">{t('hero.metric2Value')}</div>
            <div class="text-xs font-medium text-slate-400">{t('hero.metric2Label')}</div>
          </div>
          <div class="space-y-0.5">
            <div class="text-2xl sm:text-3xl font-extrabold text-violet-400 font-mono">{t('hero.metric3Value')}</div>
            <div class="text-xs font-medium text-slate-400">{t('hero.metric3Label')}</div>
          </div>
          <div class="space-y-0.5">
            <div class="text-2xl sm:text-3xl font-extrabold text-indigo-300 font-mono">{t('hero.metric4Value')}</div>
            <div class="text-xs font-medium text-slate-400">{t('hero.metric4Label')}</div>
          </div>
        </div>

      </div>

      <!-- Right Hero Visual Mockup (5 cols) -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-2xl glass-panel p-2 shadow-2xl glow-card border border-white/15 overflow-hidden transition-all duration-300 hover:border-violet-500/40">
          
          <!-- Mockup Window Header & Tabs -->
          <div class="flex items-center justify-between px-3 py-2 border-b border-white/10 bg-[#07080d]/80 rounded-t-xl">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/90 shadow-sm shadow-rose-500/50"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/90 shadow-sm shadow-amber-500/50"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/90 shadow-sm shadow-emerald-500/50"></span>
              
              <!-- Tab -->
              <div class="ml-2 flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-[#131524] text-[11px] font-mono text-slate-200 border border-white/10">
                <span class="text-sky-400">TS</span>
                <span>solution.ts</span>
              </div>
              <div class="hidden sm:flex items-center gap-1 px-2 py-1 text-[11px] font-mono text-slate-500 hover:text-slate-400">
                <span>test.spec.ts</span>
              </div>
            </div>

            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                {t('hero.mockStatusLive')}
              </span>
              <span class="text-[10px] font-mono text-slate-400">38ms</span>
            </div>
          </div>

          <!-- Mockup Editor Body -->
          <div class="p-4 bg-[#0a0c16]/95 rounded-b-xl font-mono text-xs text-slate-300 space-y-3">
            <div class="flex items-center justify-between text-[11px] text-slate-400 pb-2 border-b border-white/5">
              <span>TypeScript • React 19 • Algorithms</span>
              <span class="text-violet-400 font-semibold">{t('hero.mockRole')}</span>
            </div>

            <!-- Code lines with line numbers & rich highlighting -->
            <div class="space-y-1.5 text-slate-300 leading-relaxed font-mono">
              <div class="flex gap-3">
                <span class="text-slate-600 select-none text-right w-4">1</span>
                <div><span class="text-violet-400 font-semibold">export async function</span> <span class="text-sky-300">evaluateStream</span>(</div>
              </div>
              <div class="flex gap-3">
                <span class="text-slate-600 select-none text-right w-4">2</span>
                <div class="pl-4"><span class="text-slate-400">stream</span>: <span class="text-amber-300">AsyncIterable</span>&lt;<span class="text-emerald-300">Token</span>&gt;</div>
              </div>
              <div class="flex gap-3">
                <span class="text-slate-600 select-none text-right w-4">3</span>
                <div>) &#123;</div>
              </div>
              <div class="flex gap-3">
                <span class="text-slate-600 select-none text-right w-4">4</span>
                <div class="pl-4"><span class="text-violet-400">const</span> metrics = <span class="text-violet-400">new</span> <span class="text-amber-300">PerformanceTracker</span>();</div>
              </div>
              <div class="flex gap-3">
                <span class="text-slate-600 select-none text-right w-4">5</span>
                <div class="pl-4"><span class="text-violet-400">for await</span> (<span class="text-violet-400">const</span> token <span class="text-violet-400">of</span> stream) &#123;</div>
              </div>
              <div class="flex gap-3">
                <span class="text-slate-600 select-none text-right w-4">6</span>
                <div class="pl-8 text-sky-300">metrics.recordLatency(token.timestamp);</div>
              </div>
              <div class="flex gap-3">
                <span class="text-slate-600 select-none text-right w-4">7</span>
                <div class="pl-8 text-emerald-400">yield evaluatePrompt(token); <span class="inline-block w-1.5 h-3.5 bg-violet-400 animate-pulse ml-0.5"></span></div>
              </div>
              <div class="flex gap-3">
                <span class="text-slate-600 select-none text-right w-4">8</span>
                <div class="pl-4">&#125;</div>
              </div>
              <div class="flex gap-3">
                <span class="text-slate-600 select-none text-right w-4">9</span>
                <div>&#125;</div>
              </div>
            </div>

            <!-- AI Feedback Floating Banner -->
            <div class="mt-4 p-3.5 rounded-xl bg-violet-950/60 border border-violet-500/40 flex items-start gap-3 shadow-lg shadow-violet-950/50 backdrop-blur-md">
              <div class="w-7 h-7 rounded-lg bg-gradient-to-tr from-violet-600 to-indigo-600 flex items-center justify-center shrink-0 shadow-md shadow-violet-600/40 text-white font-bold text-xs">
                AI
              </div>
              <div class="text-[11px] leading-relaxed">
                <div class="font-semibold text-violet-200 flex items-center gap-2">
                  <span>{t('hero.mockAiFeedbackTitle')}</span>
                  <span class="text-[9px] px-1.5 py-0.2 rounded bg-violet-500/30 text-violet-200 font-mono">{t('hero.metric3Value')}</span>
                </div>
                <div class="text-slate-300 mt-1">
                  {t('hero.mockAiFeedbackText')}
                </div>
              </div>
            </div>

            <!-- Test Output Badge -->
            <div class="pt-2 flex items-center justify-between text-[11px] text-slate-400 border-t border-white/5">
              <div class="flex items-center gap-1.5 text-emerald-400 font-medium">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                {t('hero.mockTestsPassed')}
              </div>
              <span class="text-slate-400 font-mono font-medium">{t('hero.mockComplexity')}</span>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>
