---
// Hero.astro
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
  <!-- Glow background elements -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-violet-600/15 blur-[120px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-1/3 left-1/4 w-[400px] h-[300px] bg-indigo-500/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Hero Content (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/20 text-violet-300 text-xs font-semibold tracking-wide uppercase mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-violet-400 animate-pulse"></span>
          {t('hero.badge')}
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1] mb-6">
          {t('hero.title1')} <br class="hidden sm:inline" />
          <span class="text-gradient-purple">{t('hero.title2')}</span>
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl text-slate-400 font-normal leading-relaxed mb-8 max-w-xl">
          {t('hero.subtitle')}
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap items-center gap-4 w-full sm:w-auto mb-12">
          <a
            href="#cta"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-base font-semibold text-white bg-violet-600 hover:bg-violet-500 rounded-full px-8 py-3.5 shadow-xl shadow-violet-600/30 hover:shadow-violet-500/50 hover:scale-[1.02] active:scale-[0.98] transition-all"
          >
            {t('hero.ctaStart')}
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a
            href="#how-it-works"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-base font-semibold text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 rounded-full px-7 py-3.5 backdrop-blur-sm transition-all"
          >
            {t('hero.ctaExplore')}
          </a>
        </div>

        <!-- Metrics Strip -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-6 border-t border-white/10 w-full max-w-2xl">
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white">{t('hero.metric1Value')}</div>
            <div class="text-xs font-medium text-slate-400 mt-0.5">{t('hero.metric1Label')}</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white">{t('hero.metric2Value')}</div>
            <div class="text-xs font-medium text-slate-400 mt-0.5">{t('hero.metric2Label')}</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white">{t('hero.metric3Value')}</div>
            <div class="text-xs font-medium text-slate-400 mt-0.5">{t('hero.metric3Label')}</div>
          </div>
          <div>
            <div class="text-2xl sm:text-3xl font-extrabold text-white">{t('hero.metric4Value')}</div>
            <div class="text-xs font-medium text-slate-400 mt-0.5">{t('hero.metric4Label')}</div>
          </div>
        </div>

      </div>

      <!-- Right Hero Visual Mockup (5 cols) -->
      <div class="lg:col-span-5 relative">
        <div class="relative rounded-2xl glass-panel p-2 shadow-2xl shadow-violet-950/50 border border-white/15 overflow-hidden">
          
          <!-- Mockup Window Header -->
          <div class="flex items-center justify-between px-3 py-2 border-b border-white/5 bg-[#090a10]/60 rounded-t-xl">
            <div class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-500/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-500/80"></span>
              <span class="ml-2 text-xs font-mono text-slate-400 truncate">mock_session_4092.tsx</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[10px] font-medium bg-emerald-500/15 text-emerald-400 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                LIVE
              </span>
              <span class="text-[10px] font-mono text-slate-400">42ms</span>
            </div>
          </div>

          <!-- Mockup Editor Body -->
          <div class="p-4 bg-[#0d0e17] rounded-b-xl font-mono text-xs text-slate-300 space-y-3">
            <div class="flex items-center justify-between text-[11px] text-slate-400 pb-2 border-b border-white/5">
              <span>TypeScript • React 19 • Algorithms</span>
              <span class="text-violet-400 font-semibold">{t('hero.mockRole')}</span>
            </div>

            <!-- Code lines -->
            <div class="space-y-1 text-slate-300">
              <div><span class="text-violet-400">export async function</span> <span class="text-sky-300">evaluateStream</span>(</div>
              <div class="pl-4"><span class="text-slate-400">stream</span>: <span class="text-amber-300">AsyncIterable</span>&lt;<span class="text-emerald-300">Token</span>&gt;</div>
              <div>) &#123;</div>
              <div class="pl-4 text-slate-400"><span class="text-violet-400">const</span> metrics = <span class="text-violet-400">new</span> <span class="text-amber-300">PerformanceTracker</span>();</div>
              <div class="pl-4"><span class="text-violet-400">for await</span> (<span class="text-violet-400">const</span> token <span class="text-violet-400">of</span> stream) &#123;</div>
              <div class="pl-8 text-sky-300">metrics.recordLatency(token.timestamp);</div>
              <div class="pl-8 text-emerald-400">yield evaluatePrompt(token);</div>
              <div class="pl-4">&#125;</div>
              <div>&#125;</div>
            </div>

            <!-- AI Feedback Floating Banner -->
            <div class="mt-4 p-3 rounded-xl bg-violet-950/40 border border-violet-500/30 flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-violet-600 flex items-center justify-center shrink-0 shadow-md shadow-violet-600/30 text-white font-bold text-xs">
                AI
              </div>
              <div class="text-[11px] leading-relaxed">
                <div class="font-semibold text-violet-200">{t('hero.mockAiFeedbackTitle')}</div>
                <div class="text-slate-300 mt-0.5">
                  {t('hero.mockAiFeedbackText')}
                </div>
              </div>
            </div>

            <!-- Test Output Badge -->
            <div class="pt-2 flex items-center justify-between text-[10px] text-slate-400">
              <div class="flex items-center gap-1.5 text-emerald-400 font-medium">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                {t('hero.mockTestsPassed')}
              </div>
              <span class="text-slate-500">Complexity: O(n)</span>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>
