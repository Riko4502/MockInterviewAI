---
import { getRegisterUrl } from "@/config/navigation";
// CTA.astro
import { type Lang, useTranslations } from "@/i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "ru" } = Astro.props;
const t = useTranslations(lang);
const registerUrl = getRegisterUrl();
---

<section id="cta" class="relative py-20 md:py-28 overflow-hidden bg-[#07080e]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- CTA Card Box -->
    <div class="relative rounded-3xl p-8 sm:p-12 md:p-16 border border-violet-500/30 overflow-hidden shadow-2xl glow-card text-center bg-gradient-to-b from-[#121424] to-[#0a0c16]">
      
      <!-- Ambient Glow Behind CTA -->
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-gradient-to-r from-violet-600/30 via-indigo-600/30 to-purple-600/30 blur-[120px] pointer-events-none -z-10"></div>

      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-violet-500/10 border border-violet-500/30 text-violet-300 text-xs font-semibold tracking-wider uppercase mb-6 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>{t('cta.badge')}</span>
      </div>

      <!-- Title -->
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight max-w-3xl mx-auto mb-6 leading-tight">
        {t('cta.title')}
      </h2>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
        {t('cta.subtitle')}
      </p>

      <!-- Action Button -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10">
        <a
          href={registerUrl}
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 text-base font-semibold text-white bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 rounded-full px-9 py-4 shadow-xl shadow-violet-600/40 hover:shadow-violet-500/60 hover:scale-[1.03] active:scale-[0.98] transition-all"
        >
          <span>{t('cta.button')}</span>
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- Key Benefits List -->
      <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs sm:text-sm text-slate-400 font-medium border-t border-white/10 pt-8 max-w-2xl mx-auto">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{t('cta.benefit1')}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{t('cta.benefit2')}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>{t('cta.benefit3')}</span>
        </div>
      </div>

    </div>

  </div>
</section>
