---
// StepScorecard.astro
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const t = useTranslations(lang);
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
  <div class="lg:col-span-6 lg:order-2 flex flex-col items-start">
    <div class="flex items-center gap-3 mb-4">
      <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-violet-600/20 border border-violet-500/40 text-violet-400 font-mono font-bold text-xs">
        04
      </span>
      <span class="text-xs font-mono font-semibold text-violet-400 tracking-wider">
        {t('howItWorks.step4Tag')}
      </span>
    </div>

    <h3 class="text-2xl sm:text-3xl font-bold text-white mb-4">
      {t('howItWorks.step4Title')}
    </h3>
    <p class="text-slate-300 text-base leading-relaxed mb-6">
      {t('howItWorks.step4Desc')}
    </p>
    <div class="space-y-4 w-full">
      <div>
        <div class="flex justify-between text-xs font-semibold mb-1.5">
          <span class="text-slate-200">{t('howItWorks.skillAlgo')}</span>
          <span class="text-violet-400 font-mono">96 / 100</span>
        </div>
        <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
          <div class="h-full rounded-full bg-gradient-to-r from-violet-600 to-indigo-500 w-[96%] shadow-sm"></div>
        </div>
      </div>
      <div>
        <div class="flex justify-between text-xs font-semibold mb-1.5">
          <span class="text-slate-200">{t('howItWorks.skillArch')}</span>
          <span class="text-violet-400 font-mono">92 / 100</span>
        </div>
        <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
          <div class="h-full rounded-full bg-gradient-to-r from-violet-600 to-indigo-500 w-[92%] shadow-sm"></div>
        </div>
      </div>
      <div>
        <div class="flex justify-between text-xs font-semibold mb-1.5">
          <span class="text-slate-200">{t('howItWorks.skillComm')}</span>
          <span class="text-violet-400 font-mono">88 / 100</span>
        </div>
        <div class="w-full h-2 rounded-full bg-slate-800 overflow-hidden">
          <div class="h-full rounded-full bg-gradient-to-r from-violet-600 to-indigo-500 w-[88%] shadow-sm"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="lg:col-span-6 lg:order-1">
    <div class="glass-panel rounded-2xl p-6 border border-white/15 shadow-xl glow-card">
      <div class="flex items-center justify-between pb-4 border-b border-white/10">
        <div>
          <div class="text-xs font-mono text-slate-400">{t('howItWorks.sessionReport')}</div>
          <div class="text-base font-bold text-white">{t('howItWorks.reportRole')}</div>
        </div>
        <div class="text-right">
          <div class="text-xl sm:text-2xl font-extrabold text-emerald-400 font-mono">{t('howItWorks.scorecardTitle')}</div>
          <div class="text-[11px] text-slate-400">{t('howItWorks.scoreLabel')}</div>
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3 my-4">
        <div class="p-3 rounded-xl bg-[#0a0c16] border border-white/10 text-center">
          <div class="text-lg sm:text-xl font-bold text-white font-mono">O(n)</div>
          <div class="text-[11px] text-slate-400 mt-0.5">{t('howItWorks.timeComplexity')}</div>
        </div>
        <div class="p-3 rounded-xl bg-[#0a0c16] border border-white/10 text-center">
          <div class="text-lg sm:text-xl font-bold text-white font-mono">O(1)</div>
          <div class="text-[11px] text-slate-400 mt-0.5">{t('howItWorks.spaceComplexity')}</div>
        </div>
        <div class="p-3 rounded-xl bg-[#0a0c16] border border-white/10 text-center">
          <div class="text-lg sm:text-xl font-bold text-violet-400 font-mono">{t('howItWorks.topPercentile')}</div>
          <div class="text-[11px] text-slate-400 mt-0.5">{t('howItWorks.globalPercentile')}</div>
        </div>
      </div>

      <div class="p-3.5 rounded-xl bg-violet-950/50 border border-violet-500/30 text-xs text-slate-300 leading-relaxed shadow-sm">
        <span class="font-semibold text-violet-300">{t('howItWorks.keyRecommendation')}</span> {t('howItWorks.recommendationText')}
      </div>
    </div>
  </div>
</div>
