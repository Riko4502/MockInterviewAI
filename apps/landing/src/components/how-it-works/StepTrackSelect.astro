---
// StepTrackSelect.astro
import { type Lang, useTranslations } from "@/i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "ru" } = Astro.props;
const t = useTranslations(lang);
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
  <div class="lg:col-span-6 flex flex-col items-start">
    <div class="flex items-center gap-3 mb-4">
      <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-violet-600/20 border border-violet-500/40 text-violet-400 font-mono font-bold text-xs">
        01
      </span>
      <span class="text-xs font-mono font-semibold text-violet-400 tracking-wider">
        {t('howItWorks.step1Tag')}
      </span>
    </div>
    
    <h3 class="text-2xl sm:text-3xl font-bold text-white mb-4">
      {t('howItWorks.step1Title')}
    </h3>
    <p class="text-slate-300 text-base leading-relaxed mb-6">
      {t('howItWorks.step1Desc')}
    </p>
    <div class="flex flex-wrap gap-2 text-xs font-medium">
      <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-300 hover:border-violet-500/40 transition-colors">{t('howItWorks.trackTagFrontend')}</span>
      <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-300 hover:border-violet-500/40 transition-colors">{t('howItWorks.trackTagBackend')}</span>
      <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-300 hover:border-violet-500/40 transition-colors">{t('howItWorks.trackTagSystemDesign')}</span>
      <span class="px-3 py-1.5 rounded-lg bg-white/5 border border-white/10 text-slate-300 hover:border-violet-500/40 transition-colors">{t('howItWorks.trackTagAlgo')}</span>
    </div>
  </div>

  <div class="lg:col-span-6">
    <div class="glass-panel rounded-2xl p-6 border border-white/15 shadow-xl glow-card">
      <div class="flex items-center justify-between pb-4 mb-4 border-b border-white/10">
        <span class="text-sm font-semibold text-white flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-violet-400"></span>
          {t('howItWorks.step1SelectTitle')}
        </span>
        <span class="text-xs text-violet-400 font-medium font-mono">{t('howItWorks.step1Customizable')}</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <div class="p-4 rounded-xl bg-violet-950/40 border-2 border-violet-500 flex flex-col justify-between cursor-pointer shadow-lg shadow-violet-950/50">
          <div>
            <div class="text-sm font-bold text-white">{t('howItWorks.track1Title')}</div>
            <div class="text-xs text-slate-300 mt-1">{t('howItWorks.track1Desc')}</div>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] text-violet-300 font-mono">
            <span>60 min</span>
            <span class="text-emerald-400 font-semibold px-2 py-0.5 rounded bg-emerald-500/15 border border-emerald-500/20">{t('howItWorks.track1Status')}</span>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition-all flex flex-col justify-between cursor-pointer hover:bg-white/[0.05]">
          <div>
            <div class="text-sm font-bold text-white">{t('howItWorks.track2Title')}</div>
            <div class="text-xs text-slate-400 mt-1">{t('howItWorks.track2Desc')}</div>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] text-slate-400 font-mono">
            <span>45 min</span>
            <span class="text-slate-300">{t('howItWorks.selectAction')}</span>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition-all flex flex-col justify-between cursor-pointer hover:bg-white/[0.05]">
          <div>
            <div class="text-sm font-bold text-white">{t('howItWorks.track3Title')}</div>
            <div class="text-xs text-slate-400 mt-1">{t('howItWorks.track3Desc')}</div>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] text-slate-400 font-mono">
            <span>60 min</span>
            <span class="text-slate-300">{t('howItWorks.selectAction')}</span>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10 hover:border-white/20 transition-all flex flex-col justify-between cursor-pointer hover:bg-white/[0.05]">
          <div>
            <div class="text-sm font-bold text-white">{t('howItWorks.track4Title')}</div>
            <div class="text-xs text-slate-400 mt-1">{t('howItWorks.track4Desc')}</div>
          </div>
          <div class="mt-3 flex items-center justify-between text-[11px] text-slate-400 font-mono">
            <span>45 min</span>
            <span class="text-slate-300">{t('howItWorks.selectAction')}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
