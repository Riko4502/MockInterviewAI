---
// StepLiveCoding.astro
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const t = useTranslations(lang);
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
  <div class="lg:col-span-6 flex flex-col items-start">
    <div class="flex items-center gap-3 mb-4">
      <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-violet-600/20 border border-violet-500/40 text-violet-400 font-mono font-bold text-xs">
        03
      </span>
      <span class="text-xs font-mono font-semibold text-violet-400 tracking-wider">
        {t('howItWorks.step3Tag')}
      </span>
    </div>

    <h3 class="text-2xl sm:text-3xl font-bold text-white mb-4">
      {t('howItWorks.step3Title')}
    </h3>
    <p class="text-slate-300 text-base leading-relaxed mb-6">
      {t('howItWorks.step3Desc')}
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full text-xs">
      <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-violet-500/30 transition-colors">
        <div class="font-bold text-white text-sm">{t('howItWorks.badgeLanguages')}</div>
        <div class="text-slate-400 mt-1">{t('howItWorks.badgeLanguagesDesc')}</div>
      </div>
      <div class="p-3.5 rounded-xl bg-white/5 border border-white/10 hover:border-violet-500/30 transition-colors">
        <div class="font-bold text-white text-sm">{t('howItWorks.badgeTests')}</div>
        <div class="text-slate-400 mt-1">{t('howItWorks.badgeTestsDesc')}</div>
      </div>
    </div>
  </div>

  <div class="lg:col-span-6">
    <div class="glass-panel rounded-2xl p-4 border border-white/15 shadow-xl glow-card font-mono text-xs">
      <div class="flex items-center justify-between pb-3 mb-3 border-b border-white/10 text-slate-400 text-[11px]">
        <div class="flex items-center gap-2">
          <span class="text-white font-semibold flex items-center gap-1.5">
            <span class="text-sky-400 font-bold">TS</span>
            lru_cache.ts
          </span>
          <span class="text-slate-600">•</span>
          <span class="text-slate-400">TypeScript 5.7</span>
        </div>
        <span class="px-2.5 py-0.5 rounded-md bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 text-[10px] font-semibold">
          ✓ {t('howItWorks.buildPassing')}
        </span>
      </div>

      <div class="space-y-1.5 text-slate-300 py-2 leading-relaxed bg-[#0a0c16] p-3 rounded-xl border border-white/5 font-mono">
        <div><span class="text-violet-400 font-semibold">class</span> <span class="text-amber-300">LRUCache</span>&lt;<span class="text-emerald-300">K, V</span>&gt; &#123;</div>
        <div class="pl-4"><span class="text-violet-400">private</span> capacity: <span class="text-amber-300">number</span>;</div>
        <div class="pl-4"><span class="text-violet-400">private</span> cache = <span class="text-violet-400">new</span> <span class="text-amber-300">Map</span>&lt;<span class="text-emerald-300">K, V</span>&gt;();</div>
        <div class="pl-4"><span class="text-violet-400">get</span>(key: <span class="text-emerald-300">K</span>): <span class="text-emerald-300">V</span> | <span class="text-violet-400">undefined</span> &#123;</div>
        <div class="pl-8 text-slate-400"><span class="text-violet-400">if</span> (!<span class="text-violet-400">this</span>.cache.has(key)) <span class="text-violet-400">return undefined</span>;</div>
        <div class="pl-8 text-sky-300">const val = this.cache.get(key)!;</div>
        <div class="pl-8 text-emerald-400">this.cache.delete(key); this.cache.set(key, val);</div>
        <div class="pl-8 text-violet-400">return val;</div>
        <div class="pl-4">&#125;</div>
        <div>&#125;</div>
      </div>

      <!-- AI Hint Notification (visible to both participants) -->
      <div class="mt-3 p-3 rounded-xl bg-violet-950/60 border border-violet-500/40 text-[11px] text-violet-200">
        <div class="flex items-center justify-between font-semibold mb-1">
          <span class="flex items-center gap-1.5 text-violet-300">
            <span>💡</span> {lang === 'ru' ? 'Подсказка ИИ (Осталось: 2 из 3)' : 'AI Hint (2 of 3 remaining)'}
          </span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-violet-500/30 text-violet-200 font-mono">
            {lang === 'ru' ? 'Видно обоим' : 'Visible to all'}
          </span>
        </div>
        <div class="text-slate-300 text-[10.5px]">
          {lang === 'ru'
            ? '«Для O(1) доступа и сохранения порядка удаления рассмотрите комбинацию Hash Map и двусвязного списка.»'
            : '"For O(1) access and eviction order, consider combining a Hash Map with a Doubly Linked List."'}
        </div>
      </div>

      <div class="mt-3 p-2.5 rounded-xl bg-slate-900/90 border border-white/10 flex items-center justify-between text-[11px]">
        <div class="flex items-center gap-2 text-emerald-400 font-medium">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{t('howItWorks.allTestsPassed')}</span>
        </div>
        <div class="text-slate-300">
          {t('howItWorks.runtimeBeats')}
        </div>
      </div>
    </div>
  </div>
</div>
