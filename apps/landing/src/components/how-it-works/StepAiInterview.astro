---
// StepAiInterview.astro
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'ru' } = Astro.props;
const t = useTranslations(lang);
---

<div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
  <div class="lg:col-span-6 lg:order-2 flex flex-col items-start">
    <div class="flex items-center gap-3 mb-4">
      <span class="flex items-center justify-center w-8 h-8 rounded-xl bg-violet-600/20 border border-violet-500/40 text-violet-400 font-mono font-bold text-xs">
        02
      </span>
      <span class="text-xs font-mono font-semibold text-violet-400 tracking-wider">
        {t('howItWorks.step2Tag')}
      </span>
    </div>

    <h3 class="text-2xl sm:text-3xl font-bold text-white mb-4">
      {t('howItWorks.step2Title')}
    </h3>
    <p class="text-slate-300 text-base leading-relaxed mb-6">
      {t('howItWorks.step2Desc')}
    </p>
    <ul class="space-y-3 text-sm text-slate-200">
      <li class="flex items-center gap-3">
        <div class="w-5 h-5 rounded-full bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-xs font-bold shrink-0">✓</div>
        <span>{t('howItWorks.step2Check1')}</span>
      </li>
      <li class="flex items-center gap-3">
        <div class="w-5 h-5 rounded-full bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-xs font-bold shrink-0">✓</div>
        <span>{t('howItWorks.step2Check2')}</span>
      </li>
      <li class="flex items-center gap-3">
        <div class="w-5 h-5 rounded-full bg-emerald-500/20 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-xs font-bold shrink-0">✓</div>
        <span>{t('howItWorks.step2Check3')}</span>
      </li>
    </ul>
  </div>

  <div class="lg:col-span-6 lg:order-1">
    <div class="glass-panel rounded-2xl p-4 border border-white/15 shadow-xl glow-card overflow-hidden">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
        <!-- AI Interviewer Feed -->
        <div class="relative rounded-xl bg-slate-900/90 border border-violet-500/40 p-4 aspect-video flex flex-col justify-between overflow-hidden shadow-inner">
          <div class="absolute inset-0 bg-radial-hero opacity-60"></div>
          <div class="relative z-10 flex items-center justify-between text-[11px] text-slate-300">
            <span class="flex items-center gap-1.5 font-medium text-white">
              <span class="w-2 h-2 rounded-full bg-violet-400 animate-pulse"></span>
              {t('howItWorks.aiInterviewer')}
            </span>
            <span class="px-1.5 py-0.5 rounded bg-violet-500/20 text-violet-300 font-mono text-[10px] border border-violet-500/30">{t('howItWorks.aiRole')}</span>
          </div>
          
          <div class="relative z-10 flex items-center justify-center py-2">
            <div class="w-14 h-14 rounded-full bg-gradient-to-tr from-violet-600 to-indigo-600 flex items-center justify-center shadow-lg shadow-violet-600/40 ring-4 ring-violet-500/20">
              <svg class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
                <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
                <line x1="12" y1="19" x2="12" y2="22"></line>
              </svg>
            </div>
          </div>

          <!-- Animated Audio Wavebars -->
          <div class="relative z-10 flex items-center justify-center gap-1">
            <span class="w-1 h-3 bg-violet-400 rounded-full animate-bounce"></span>
            <span class="w-1 h-6 bg-violet-300 rounded-full animate-bounce" style="animation-delay: 0.1s"></span>
            <span class="w-1 h-4 bg-indigo-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></span>
            <span class="w-1 h-7 bg-violet-400 rounded-full animate-bounce" style="animation-delay: 0.3s"></span>
            <span class="w-1 h-3 bg-indigo-300 rounded-full animate-bounce" style="animation-delay: 0.15s"></span>
          </div>
        </div>

        <!-- Candidate Feed -->
        <div class="relative rounded-xl bg-slate-900/90 border border-white/10 p-4 aspect-video flex flex-col justify-between overflow-hidden shadow-inner">
          <div class="flex items-center justify-between text-[11px] text-slate-300">
            <span class="flex items-center gap-1.5 font-medium text-white">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              {t('howItWorks.candidateYou')}
            </span>
            <span class="text-slate-400 font-mono text-[10px]">1080p 60fps</span>
          </div>
          
          <div class="flex items-center justify-center py-2">
            <div class="w-14 h-14 rounded-full bg-slate-800 border border-white/15 flex items-center justify-center text-slate-300 text-base font-bold shadow-md">
              DEV
            </div>
          </div>
          
          <div class="flex items-center justify-between text-[10px] text-slate-400">
            <span class="flex items-center gap-1 text-emerald-400">● {t('howItWorks.micActive')}</span>
            <span class="text-emerald-400 font-medium">{t('howItWorks.clearAudio')}</span>
          </div>
        </div>
      </div>

      <!-- Dialogue bubble -->
      <div class="p-3.5 rounded-xl bg-[#0a0c16] border border-white/10 text-xs text-slate-300 leading-relaxed shadow-sm">
        <span class="text-violet-400 font-semibold">{t('howItWorks.dialogueSpeaker')}</span> {t('howItWorks.dialogueText')}
      </div>
    </div>
  </div>
</div>
