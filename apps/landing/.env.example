# ==============================================================================
# Landing Environment Variables (.env.example)
# ==============================================================================

# Node Environment
NODE_ENV=development

# Base URL for the public landing website (canonical URLs, sitemap, robots)
# Dev default: http://localhost:4321
# Production: https://mockinterviewai.com (cannot contain 'localhost' in production)
NEXT_PUBLIC_SITE_URL=http://localhost:4321

# Web Application URL (used for external redirects: Try Now, Go to App)
# Dev default: http://localhost:3000
# Production: https://app.mockinterviewai.com (cannot contain 'localhost' in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication URL for "Sign In" / "Log In" button
# Dev default: ${NEXT_PUBLIC_APP_URL}/login
# Production: https://app.mockinterviewai.com/login (cannot contain 'localhost' in production)
NEXT_PUBLIC_AUTH_URL=http://localhost:3000/login

# Registration URL for "Get Started" / "Sign Up" button
# Dev default: ${NEXT_PUBLIC_APP_URL}/register
# Production: https://app.mockinterviewai.com/register (cannot contain 'localhost' in production)
NEXT_PUBLIC_REGISTER_URL=http://localhost:3000/register

# GitHub repository link in navigation and footer
# Default: https://github.com/Riko4502/MockInterviewAI
NEXT_PUBLIC_GITHUB_URL=https://github.com/Riko4502/MockInterviewAI
