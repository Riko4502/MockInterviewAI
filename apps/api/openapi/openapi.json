            "type": "string",
            "minLength": 1
          }
        },
        "required": ["email", "password", "passwordConfirmation"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "minLength": 1,
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": ["email", "password"]
      },
