              "type": "string"
            },
            "example": {
              "email": "Некорректный email"
            },
            "description": "Карта ошибок `{ field: message }`."
          }
        },
        "required": ["statusCode", "message"]
      },
      "ErrorResponseDto": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "number",
            "example": 401
