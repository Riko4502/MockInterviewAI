  "info": {
    "title": "Mock Interview AI API",
    "description": "Auth API: register, login, logout.\n\nRefresh token передаётся только через HttpOnly cookie\n(HttpOnly; SameSite=Lax; Path=/api/v1/auth; Max-Age=JWT_REFRESH_EXPIRATION)\nи не возвращается в JSON response.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:3001"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UserProfileDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "displayName": {
            "nullable": true,
            "type": "string"
          },
          "username": {
            "nullable": true,
            "type": "string"
          },
          "avatarUrl": {
            "nullable": true,
            "type": "string"
          },
          "telegramUsername": {
            "nullable": true,
            "type": "string"
          },
          "gitUrl": {
            "nullable": true,
            "type": "string"
          },
          "createdAt": {
            "anyOf": [
              {},
              {
                "type": "string"
              }
            ]
          },
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "updatedAt": {
            "anyOf": [
              {},
              {
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "id",
          "displayName",
          "username",
          "avatarUrl",
          "telegramUsername",
          "gitUrl",
          "createdAt",
          "email",
          "updatedAt"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50
          },
          "username": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{3,30}$"
          },
          "avatarUrl": {
            "nullable": true,
            "type": "string",
            "format": "uri"
          },
          "telegramUsername": {
            "nullable": true,
            "type": "string",
            "pattern": "^@?[a-zA-Z0-9_]{5,32}$"
          },
          "gitUrl": {
            "nullable": true,
            "type": "string",
            "pattern": "^https?:\\/\\/(www\\.)?(github|gitlab)\\.com\\/[a-zA-Z0-9_.-]+\\/?$"
          }
        }
      },
      "AvatarUploadResponseDto": {
        "type": "object",
        "properties": {
