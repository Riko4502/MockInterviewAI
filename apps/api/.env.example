# Database
API_DATABASE_URL=postgresql://mock_interview:mock_interview@localhost:5432/mock_interview?schema=public

# Argon2id
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Cookie
COOKIE_SECURE=false

# Rate limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# GitHub OAuth (configure all four values to enable)
# GITHUB_CLIENT_ID=your-client-id
# GITHUB_CLIENT_SECRET=your-client-secret
# GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback
# FRONTEND_URL=http://localhost:3000

# Telegram Bot integration (apps/telegram-bot <-> apps/api)
# Сервисный ключ для X-Internal-Service-Key (мин. 32 симв.);
# должен совпадать с ключом бота и с прод (.env сервера / Render devsync-api).
INTERNAL_SERVICE_KEY=change-me-internal-service-secret-key-min-32-chars
