generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  slug        String       @unique
  name        String
  description String?
  permissions BigInt       @default(0)
  isSystem    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  users       User[]

  @@map("roles")
  @@index([slug])
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  bitValue    BigInt
  createdAt   DateTime @default(now())

  @@map("permissions")
  @@index([slug])
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String
  roleId           String?   @db.Uuid
  role             Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  displayName      String?
  username         String?   @unique
  avatarUrl        String?
  telegramUsername String?
  telegramChatId   String?   @unique
  telegramLocale   String?
  gitUrl           String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  notifications  Notification[]
  sessions       InterviewSession[]
  participations InterviewParticipant[]
  revocationTasks  AuthRevocationTask[]

  @@map("users")
  @@index([username])
  @@index([roleId])
  @@index([deletedAt])
}

model AuthRevocationTask {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@map("auth_revocation_tasks")
  @@index([userId])
  @@index([createdAt])
}

enum InterviewSessionStatus {
  CREATED
  ACTIVE
  CLOSED
}

enum InterviewParticipantRole {
  CANDIDATE
  INTERVIEWER
  OBSERVER
}

model InterviewSession {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @db.Uuid // владелец (создатель) сессии
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       InterviewSessionStatus  @default(ACTIVE)
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  participants InterviewParticipant[]

  @@map("interview_sessions")
  @@index([userId])
  @@index([status])
}

model InterviewParticipant {
  sessionId String  @db.Uuid
  userId    String  @db.Uuid
  role      InterviewParticipantRole

  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@map("interview_participants")
  @@index([userId])
}

enum NotificationType {
  SYSTEM
  INTERVIEW
  MESSAGE
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  category  NotificationType
  title     String
  message   String
  actionUrl String?
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([readAt])
  @@index([deletedAt])
}
