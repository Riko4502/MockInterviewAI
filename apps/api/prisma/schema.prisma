generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  email            String   @unique
  passwordHash     String
  displayName      String?
  username         String?  @unique
  avatarUrl        String?
  telegramUsername String?
  gitUrl           String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  notifications Notification[]
  sessions         InterviewSession[]
  participations   InterviewParticipant[]

  @@map("users")
  @@index([username])
  @@index([deletedAt])
}

enum InterviewSessionStatus {
  CREATED
  ACTIVE
  CLOSED
}

enum InterviewParticipantRole {
  CANDIDATE
  INTERVIEWER
  OBSERVER
}

model InterviewSession {
  id           String                  @id @default(uuid()) @db.Uuid
  userId       String                  @db.Uuid // владелец (создатель) сессии
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       InterviewSessionStatus  @default(ACTIVE)
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  participants InterviewParticipant[]

  @@map("interview_sessions")
  @@index([userId])
  @@index([status])
}

model InterviewParticipant {
  sessionId String  @db.Uuid
  userId    String  @db.Uuid
  role      InterviewParticipantRole

  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@map("interview_participants")
  @@index([userId])
}

enum NotificationType {
  SYSTEM
  INTERVIEW
  MESSAGE
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  category  NotificationType
  title     String
  message   String
  actionUrl String?
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@index([userId])
  @@index([readAt])
  @@index([deletedAt])
}
