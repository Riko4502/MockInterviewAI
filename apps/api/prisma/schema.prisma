generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  permissions BigInt   @default(0)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]

  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  description String?
  bitValue    BigInt
  createdAt   DateTime @default(now())

  @@index([slug])
  @@map("permissions")
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  passwordHash     String?
  githubId         String?   @unique
  roleId           String?   @db.Uuid
  role             Role?     @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive         Boolean   @default(true)
  deactivatedAt    DateTime?
  displayName      String?
  username         String?   @unique
  avatarUrl        String?
  telegramId           BigInt?   @unique
  telegramUsername     String?
  telegramChatId       String?   @unique
  telegramLocale       String?
  telegramLinkVerified Boolean   @default(false)
  gitUrl           String?
  theme            ThemePreference @default(DARK)
  locale           String          @default("ru")
  deletedAt        DateTime?
  generation       Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  deviceSettings        UserDeviceSettings[]
  notifications         Notification[]
  createdNotificationCampaigns NotificationCampaign[] @relation("NotificationCampaignCreator")
  cancelledNotificationCampaigns NotificationCampaign[] @relation("NotificationCampaignCanceller")
  notificationCampaignRecipients NotificationCampaignRecipient[] @relation("NotificationCampaignRecipients")
  sessions              InterviewSession[]
  participations        InterviewParticipant[]
  revocationTasks       AuthRevocationTask[]
  showcaseCards         ShowcaseCard[]         @relation("UserShowcaseCards")
  sentMatchRequests     MatchRequest[]         @relation("UserSentMatchRequests")
  receivedMatchRequests MatchRequest[]         @relation("UserReceivedMatchRequests")

  @@index([githubId])
  @@index([username])
  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([telegramId])
  @@index([createdAt])
  @@map("users")
}

model AuthRevocationTask {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation Int?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("auth_revocation_tasks")
}

enum InterviewSessionStatus {
  CREATED
  ACTIVE
  CLOSED
}

enum InterviewParticipantRole {
  CANDIDATE
  INTERVIEWER
  OBSERVER
}

model InterviewSession {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @db.Uuid // владелец (создатель) сессии
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       InterviewSessionStatus @default(ACTIVE)
  inviteToken  String?                @map("invite_token") @db.VarChar(128)
  startedAt    DateTime?
  endedAt      DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  participants InterviewParticipant[]
  matchRequests MatchRequest[]

  @@index([userId])
  @@index([status])
  @@map("interview_sessions")
}

model InterviewParticipant {
  sessionId String                   @db.Uuid
  userId    String                   @db.Uuid
  role      InterviewParticipantRole

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([userId])
  @@map("interview_participants")
}

enum NotificationType {
  SYSTEM
  INTERVIEW
  MESSAGE
}

model NotificationCampaignRecipient {
  id         String               @id @default(uuid()) @db.Uuid
  campaignId String               @map("campaign_id") @db.Uuid
  campaign   NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String               @map("user_id") @db.Uuid
  user       User                 @relation("NotificationCampaignRecipients", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now()) @map("created_at")

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("notification_campaign_recipients")
}
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  category  NotificationType
  title     String
  message   String
  actionUrl String?
  campaignId String? @map("campaign_id") @db.Uuid
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign NotificationCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([deletedAt])
  @@index([campaignId])
  @@unique([campaignId, userId])
  @@map("notifications")
}

enum NotificationTargetType {
  ALL
  SPECIFIC
}

enum NotificationCampaignStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

model NotificationCampaign {
  id                  String                       @id @default(uuid()) @db.Uuid
  title               String                       @db.VarChar(200)
  category            NotificationType
  message             String                       @db.VarChar(2000)
  actionUrl           String?                      @map("action_url")
  targetType          NotificationTargetType       @map("target_type")
  recipients          NotificationCampaignRecipient[]
  status              NotificationCampaignStatus   @default(DRAFT)
  scheduledAt         DateTime?                    @map("scheduled_at")
  sentAt              DateTime?                    @map("sent_at")
  completedAt         DateTime?                    @map("completed_at")
  totalRecipients     Int                          @default(0) @map("total_recipients")
  sentCount           Int                          @default(0) @map("sent_count")
  lastProcessedUserId String?                      @map("last_processed_user_id") @db.Uuid
  processingStartedAt DateTime?                    @map("processing_started_at")
  creatorId           String?                      @map("creator_id") @db.Uuid
  creator             User?                        @relation("NotificationCampaignCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  cancelledAt         DateTime?                    @map("cancelled_at")
  cancelledById       String?                      @map("cancelled_by_id") @db.Uuid
  cancelledBy         User?                        @relation("NotificationCampaignCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancellationReason  String?                      @map("cancellation_reason")
  failureReason       String?                      @map("failure_reason")
  notifications       Notification[]
  createdAt           DateTime                     @default(now()) @map("created_at")
  updatedAt           DateTime                     @updatedAt @map("updated_at")

  @@index([status, scheduledAt])
  @@index([creatorId, createdAt(sort: Desc)])
  @@map("notification_campaigns")
}
enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum Specialization {
  FRONTEND
  BACKEND
  FULLSTACK
  DEVOPS
  QA
  MOBILE
  DATA_ML
  SYSTEM_DESIGN
}

enum ExperienceLevel {
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
}

enum InterviewLanguage {
  RU
  EN
  ANY
}

enum ShowcaseCardStatus {
  ACTIVE // Активна и отображается на витрине
  INACTIVE // Временно скрыта пользователем вручную
  EXPIRED // Истек 15-дневный срок жизни (архив)
}

enum MatchRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

// Анкета на витрине
model ShowcaseCard {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation("UserShowcaseCards", fields: [userId], references: [id], onDelete: Cascade)

  title          String?           @db.VarChar(100) // Например: "Ищу Middle Go для мока по алгоритмам"
  specialization Specialization
  level          ExperienceLevel
  language       InterviewLanguage @default(RU)
  skills         String[]          @default([]) // ["react", "typescript", "tailwind"]
  bio            String?           @db.VarChar(500)
  scheduleInfo   String?           @map("schedule_info") @db.VarChar(300) // Например: "Будни 19:00-22:00 МСК"

  isUrgent  Boolean            @default(false) @map("is_urgent") // Бейдж "Готов сегодня"
  status    ShowcaseCardStatus @default(ACTIVE)
  autoRenew Boolean            @default(false) @map("auto_renew") // Авто-продление каждые 15 дней

  bumpedAt  DateTime @default(now()) @map("bumped_at") // Время последнего поднятия в топ
  expiresAt DateTime @map("expires_at") // now() + 15 days

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  receivedRequests MatchRequest[] @relation("TargetCardRequests")
  senderRequests   MatchRequest[] @relation("SenderCardRequests")

  @@unique([userId, specialization, level], map: "unique_active_user_specialization_level", where: { status: "ACTIVE" })
  @@index([specialization, level])
  @@index([language])
  @@index([status])
  @@index([isUrgent])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([bumpedAt(sort: Desc)])
  @@index([skills], type: Gin)
  @@map("showcase_cards")
}

// Запрос на интервью
model MatchRequest {
  id String @id @default(uuid()) @db.Uuid

  // Отправитель
  senderId String @map("sender_id") @db.Uuid
  sender   User   @relation("UserSentMatchRequests", fields: [senderId], references: [id], onDelete: Cascade)

  // Получатель
  receiverId String @map("receiver_id") @db.Uuid
  receiver   User   @relation("UserReceivedMatchRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  // Целевая карта
  targetCardId String       @map("target_card_id") @db.Uuid
  targetCard   ShowcaseCard @relation("TargetCardRequests", fields: [targetCardId], references: [id], onDelete: Cascade)

  // Карта отправителя
  senderCardId String?       @map("sender_card_id") @db.Uuid
  senderCard   ShowcaseCard? @relation("SenderCardRequests", fields: [senderCardId], references: [id], onDelete: SetNull)

  status         MatchRequestStatus @default(PENDING)
  message        String?            @db.VarChar(300)
  preferredTopic String?            @map("preferred_topic") @db.VarChar(100)
  rejectReason   String?            @map("reject_reason") @db.VarChar(200) // Причина отклонения
  sessionId      String?            @map("session_id") @db.Uuid
  session        InterviewSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  expiresAt DateTime @map("expires_at") // now() + 72h

  @@unique([senderId, targetCardId], map: "unique_pending_match_request_per_card", where: { status: "PENDING" })
  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([targetCardId, status])
  @@index([status, expiresAt])
  @@index([sessionId])
  @@map("match_requests")
}

model UserDeviceSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @map("user_id") @db.Uuid
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId                  String   @map("client_id") @db.VarChar(128)
  deviceName                String?  @map("device_name") @db.VarChar(128)
  audioVolume               Int      @default(80) @map("audio_volume")
  speechVolume              Int      @default(80) @map("speech_volume")
  micGain                   Int      @default(100) @map("mic_gain")
  preferredAudioInputLabel  String?  @map("preferred_audio_input_label") @db.VarChar(255)
  preferredAudioOutputLabel String?  @map("preferred_audio_output_label") @db.VarChar(255)
  preferredVideoInputLabel  String?  @map("preferred_video_input_label") @db.VarChar(255)
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  @@unique([userId, clientId])
  @@index([userId])
  @@map("user_device_settings")
}
