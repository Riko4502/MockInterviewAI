generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(255)
  description String?
  permissions BigInt   @default(0)
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  users User[]

  @@index([slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(255)
  description String?
  bitValue    BigInt
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([slug])
  @@map("permissions")
}

model User {
  id                   String           @id @default(uuid()) @db.Uuid
  email                String           @unique
  passwordHash         String?
  githubId             String?          @unique
  roleId               String?          @db.Uuid
  role                 Role?            @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive             Boolean          @default(true)
  deactivatedAt        DateTime?        @db.Timestamptz(3)
  firstLoginAt         DateTime?        @db.Timestamptz(3)
  displayName          String?
  username             String?          @unique
  avatarUrl            String?
  telegramId           BigInt?          @unique
  telegramUsername     String?
  telegramChatId       String?          @unique
  telegramLocale       String?
  telegramLinkVerified Boolean          @default(false)
  gitUrl               String?
  theme                ThemePreference  @default(DARK)
  locale               String           @default("ru")
  timezone             String           @default("Europe/Moscow")
  deletedAt            DateTime?        @db.Timestamptz(3)
  generation           Int              @default(1)
  onboardingCompleted  Boolean          @default(false) @map("onboarding_completed")
  targetRole           Specialization?  @map("target_role")
  targetLevel          ExperienceLevel? @map("target_level")
  targetCompanies      String[]         @default([]) @map("target_companies")
  targetTimeline       String?          @map("target_timeline") @db.VarChar(50)
  preferredFormat      String?          @map("preferred_format") @db.VarChar(50)
  onboardingAt         DateTime?        @map("onboarding_at")
  createdAt            DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @db.Timestamptz(3)

  deviceSettings        UserDeviceSettings[]
  notifications         Notification[]
  sessions              InterviewSession[]
  participations        InterviewParticipant[]
  revocationTasks       AuthRevocationTask[]
  showcaseCards         ShowcaseCard[]         @relation("UserShowcaseCards")
  sentMatchRequests     MatchRequest[]         @relation("UserSentMatchRequests")
  receivedMatchRequests MatchRequest[]         @relation("UserReceivedMatchRequests")

  @@index([githubId])
  @@index([username])
  @@index([roleId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([onboardingCompleted])
  @@map("users")
}

model AuthRevocationTask {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  generation Int?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([createdAt])
  @@map("auth_revocation_tasks")
}

enum InterviewSessionStatus {
  CREATED
  ACTIVE
  CLOSED
}

enum InterviewParticipantRole {
  CANDIDATE
  INTERVIEWER
  OBSERVER
}

model InterviewSession {
  id           String                 @id @default(uuid()) @db.Uuid
  userId       String                 @db.Uuid // владелец (создатель) сессии
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       InterviewSessionStatus @default(ACTIVE)
  inviteToken  String?                @map("invite_token") @db.VarChar(128)
  /// Запланированное время встречи (ADR-002:62).
  /// Заполняется при принятии заявки витрины из слота; для обычных сессий NULL.
  scheduledAt  DateTime?              @map("scheduled_at") @db.Timestamptz(3)
  startedAt    DateTime?              @db.Timestamptz(3)
  endedAt      DateTime?              @db.Timestamptz(3)
  createdAt    DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(3)
  participants InterviewParticipant[]

  /// Заявка витрины, принятие которой создало сессию; обратная ссылка на
  /// `MatchRequest.sessionId`, уникальная — одна сессия на одну заявку.
  matchRequest MatchRequest?

  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@map("interview_sessions")
}

model InterviewParticipant {
  sessionId String                   @db.Uuid
  userId    String                   @db.Uuid
  role      InterviewParticipantRole

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionId, userId])
  @@index([userId])
  @@map("interview_participants")
}

enum NotificationType {
  SYSTEM
  INTERVIEW
  MESSAGE
}

model Notification {
  id               String           @id @default(uuid()) @db.Uuid
  userId           String           @db.Uuid
  category         NotificationType
  type             String
  payload          Json
  renderedTitle    String?
  renderedMessage  String?
  renderedLocale   String?
  renderedTimezone String?
  dedupKey         String?          @unique
  actionUrl        String?
  readAt           DateTime?        @db.Timestamptz(3)
  deletedAt        DateTime?        @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([readAt])
  @@index([deletedAt])
  @@map("notifications")
}

enum NotificationOutboxStatus {
  PENDING
  DELIVERED
  FAILED
}

/// Запись outbox: событие, ожидающее доставки по каналам (ADR-003:70).
model NotificationOutbox {
  id            String                   @id @default(uuid()) @db.Uuid
  type          String
  payload       Json
  recipientId   String                   @db.Uuid
  category      NotificationType
  actionUrl     String?
  status        NotificationOutboxStatus @default(PENDING)
  attempts      Int                      @default(0)
  nextAttemptAt DateTime                 @default(now()) @db.Timestamptz(3)
  processedAt   DateTime?                @db.Timestamptz(3)
  lastError     String?
  createdAt     DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum Specialization {
  FRONTEND
  BACKEND
  FULLSTACK
  DEVOPS
  QA
  MOBILE
  DATA_ML
  SYSTEM_DESIGN
}

enum ExperienceLevel {
  JUNIOR
  MIDDLE
  SENIOR
  LEAD
}

enum InterviewLanguage {
  RU
  EN
  ANY
}

enum ShowcaseCardStatus {
  ACTIVE // Активна и отображается на витрине
  INACTIVE // Временно скрыта пользователем вручную
  EXPIRED // Истек 15-дневный срок жизни (архив)
}

enum MatchRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

/// Статус слота доступности (ADR-002:60).
///
/// OPEN — свободен для откликов, BOOKED — резерв заявки в статусе PENDING
/// (то есть занятый, но ещё не подтверждённый), CANCELLED — выведен из
/// расписания владельцем, истёкшим сроком карточки или прошедшим временем.
enum AvailabilitySlotStatus {
  OPEN
  BOOKED
  CANCELLED
}

/// Слот доступности анкеты (ADR-002:60).
///
/// `startsAt` и `endsAt` — инстанты в UTC; локальное время и смещение не
/// хранятся, зона владельца берётся из `User.timezone` при записи и
/// рендерится получателем при чтении (ADR-002:54-55).
///
/// `endsAt` дублирует `startsAt + durationMinutes` и существует не для
/// запросов, а для ограничения БД: выражение `starts_at + interval` в
/// PostgreSQL имеет класс STABLE, а индекс требует IMMUTABLE, поэтому диапазон
/// приходится строить по двум уже вычисленным инстантам. Данные пишет
/// приложение, а соответствие `endsAt` длительности закреплено CHECK-ограничением
/// в миграции — иначе поле можно было бы рассинхронизировать молча.
///
/// Ограничение «слоты одной карточки не пересекаются» обеспечивается на уровне
/// БД частичным EXCLUDE-индексом по `tstzrange(starts_at, ends_at)` — Prisma
/// такое выражение описать не может, поэтому оно живёт в миграции
/// `add_availability_slots`. Приложение проверяет пересечения сам (ADR-002:65),
/// а индекс остаётся страховкой от гонок, которые приложение не поймало
/// (ADR-002:74).
model AvailabilitySlot {
  id     String       @id @default(uuid()) @db.Uuid
  cardId String       @map("card_id") @db.Uuid
  card   ShowcaseCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  /// Начало интервала в UTC (ADR-002:60).
  startsAt        DateTime               @map("starts_at") @db.Timestamptz(3)
  durationMinutes Int                    @map("duration_minutes")
  /// Конец интервала в UTC; вычисляется приложением, проверяется БД.
  endsAt          DateTime               @map("ends_at") @db.Timestamptz(3)
  status          AvailabilitySlotStatus @default(OPEN)

  /// Заявка, зарезервировавшая слот; заполняется при отклике, поэтому слот
  /// принадлежит не пользователю, а конкретной заявке.
  bookedByRequestId String? @map("booked_by_request_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  requests MatchRequest[]

  @@index([cardId, status])
  @@index([cardId, startsAt])
  @@index([bookedByRequestId])
  @@map("availability_slots")
}

// Анкета на витрине
model ShowcaseCard {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation("UserShowcaseCards", fields: [userId], references: [id], onDelete: Cascade)

  title          String?           @db.VarChar(100) // Например: "Ищу Middle Go для мока по алгоритмам"
  specialization Specialization
  level          ExperienceLevel
  language       InterviewLanguage @default(RU)
  skills         String[]          @default([]) // ["react", "typescript", "tailwind"]
  bio            String?           @db.VarChar(500)
  scheduleInfo   String?           @map("schedule_info") @db.VarChar(300) // Например: "Будни 19:00-22:00 МСК"

  isUrgent  Boolean            @default(false) @map("is_urgent") // Бейдж "Готов сегодня"
  status    ShowcaseCardStatus @default(ACTIVE)
  autoRenew Boolean            @default(false) @map("auto_renew") // Авто-продление каждые 15 дней

  bumpedAt  DateTime @default(now()) @map("bumped_at") @db.Timestamptz(3) // Время последнего поднятия в топ
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3) // now() + 15 days

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  receivedRequests MatchRequest[]     @relation("TargetCardRequests")
  senderRequests   MatchRequest[]     @relation("SenderCardRequests")
  slots            AvailabilitySlot[]

  @@unique([userId, specialization, level], map: "unique_active_user_specialization_level", where: { status: "ACTIVE" })
  @@index([specialization, level])
  @@index([language])
  @@index([status])
  @@index([isUrgent])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([bumpedAt(sort: Desc)])
  @@index([skills], type: Gin)
  @@map("showcase_cards")
}

// Запрос на интервью
model MatchRequest {
  id String @id @default(uuid()) @db.Uuid

  // Отправитель
  senderId String @map("sender_id") @db.Uuid
  sender   User   @relation("UserSentMatchRequests", fields: [senderId], references: [id], onDelete: Cascade)

  // Получатель
  receiverId String @map("receiver_id") @db.Uuid
  receiver   User   @relation("UserReceivedMatchRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  // Целевая карта
  targetCardId String       @map("target_card_id") @db.Uuid
  targetCard   ShowcaseCard @relation("TargetCardRequests", fields: [targetCardId], references: [id], onDelete: Cascade)

  // Карта отправителя
  senderCardId String?       @map("sender_card_id") @db.Uuid
  senderCard   ShowcaseCard? @relation("SenderCardRequests", fields: [senderCardId], references: [id], onDelete: SetNull)

  // Выбранный слот расписания (ADR-002:62).
  // Слот резервируется вместе с заявкой и освобождается, если заявка не была принята.
  slotId String?           @map("slot_id") @db.Uuid
  slot   AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  // Сессия интервью, созданная при принятии заявки со слотом (ADR-002:62).
  // Уникальна: принятие заявки создаёт ровно одну сессию.
  sessionId String?           @unique @map("session_id") @db.Uuid
  session   InterviewSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  status         MatchRequestStatus @default(PENDING)
  message        String?            @db.VarChar(300)
  preferredTopic String?            @map("preferred_topic") @db.VarChar(100)
  rejectReason   String?            @map("reject_reason") @db.VarChar(200) // Причина отклонения

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3) // now() + 72h

  @@unique([senderId, targetCardId], map: "unique_pending_match_request_per_card", where: { status: "PENDING" })
  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([targetCardId, status])
  @@index([status, expiresAt])
  @@index([sessionId])
  @@map("match_requests")
}

model UserDeviceSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @map("user_id") @db.Uuid
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId                  String   @map("client_id") @db.VarChar(128)
  deviceName                String?  @map("device_name") @db.VarChar(128)
  audioVolume               Int      @default(80) @map("audio_volume")
  speechVolume              Int      @default(80) @map("speech_volume")
  micGain                   Int      @default(100) @map("mic_gain")
  preferredAudioInputLabel  String?  @map("preferred_audio_input_label") @db.VarChar(255)
  preferredAudioOutputLabel String?  @map("preferred_audio_output_label") @db.VarChar(255)
  preferredVideoInputLabel  String?  @map("preferred_video_input_label") @db.VarChar(255)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, clientId])
  @@index([userId])
  @@map("user_device_settings")
}
