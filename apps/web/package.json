{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "analyze": "next build --profile",
    "start": "next start",
    "lint": "biome check --no-errors-on-unmatched",
    "format": "biome format --write --no-errors-on-unmatched",
    "lint-staged": "lint-staged",
    "test": "vitest run --passWithNoTests",
    "test:cov": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@packages/api": "workspace:*",
    "@packages/dto": "workspace:*",
    "@packages/i18n": "workspace:^",
    "@packages/icons": "workspace:*",
    "@packages/tailwind-config": "workspace:*",
    "@packages/ui": "workspace:*",
    "@packages/editor": "workspace:*",
    "@tanstack/react-query": "^5.102.8",
    "i18next": "^26.4.2",
    "next": "16.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.12",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
