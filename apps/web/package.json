    "@packages/i18n": "workspace:^",
    "@packages/icons": "workspace:*",
    "@packages/observability": "workspace:^",
    "@packages/tailwind-config": "workspace:*",
    "@packages/types": "workspace:*",
    "@packages/ui": "workspace:*",
    "@packages/utils": "workspace:*",
    "@sentry/nextjs": "^10.73.0",
    "@tanstack/react-query": "^5.106.1",
    "eventsource": "^4",
    "i18next": "^26.7.2",
