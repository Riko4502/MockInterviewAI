{
  "name": "ui-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "storybook": "storybook dev -p 6006",
    "build": "storybook build",
    "build-storybook": "storybook build",
    "test": "echo \"No unit tests for ui-docs\"",
    "test:storybook": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook --ci\"",
    "typecheck": "tsc --noEmit",
    "vercel-ignore": "bash ../../scripts/vercel-ignore-ui-docs.sh"
  },
  "dependencies": {
    "@packages/editor": "workspace:*",
    "@packages/icons": "workspace:*",
    "@packages/tailwind-config": "workspace:*",
    "@packages/ui": "workspace:*",
    "@packages/utils": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.23"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@rsbuild/core": "^1.2.0",
    "@rsbuild/plugin-react": "^1.1.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-onboarding": "^10.6.3",
    "@storybook/addon-themes": "^10.6.3",
    "@storybook/react": "^10.6.3",
    "@storybook/test-runner": "^0.26.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "http-server": "^14.1.1",
    "playwright": "^1.64.1",
    "storybook": "^10.6.3",
    "storybook-react-rsbuild": "^3.6.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.5.1"
  }
}
