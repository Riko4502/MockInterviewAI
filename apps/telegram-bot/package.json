{
  "name": "@apps/telegram-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --no-errors-on-unmatched",
    "test": "vitest run",
    "format": "biome format --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@packages/dto": "workspace:^",
    "@packages/i18n": "workspace:^",
    "grammy": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@types/node": "^20",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
