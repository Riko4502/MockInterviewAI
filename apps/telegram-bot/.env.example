# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=change-me-from-botfather
TELEGRAM_BOT_USERNAME=MockInterviewBot

# Internal API & Security (same as apps/api)
API_INTERNAL_URL=http://localhost:3001/api/v1
INTERNAL_SERVICE_KEY=change-me-internal-service-secret-key-min-32-chars

# Frontend URL (join links to web session room)
WEB_APP_URL=http://localhost:3000

# RabbitMQ (push consumer of telegram.notifications, ADR-004).
# Leave empty in dev to run the bot without a broker; required in production.
RABBITMQ_URL=
RABBITMQ_QUEUE_NOTIFICATIONS=telegram.notifications
RABBITMQ_PREFETCH=10

# Webhook mode (prod). Leave empty for Long Polling (dev).
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PORT=8443

NODE_ENV=development