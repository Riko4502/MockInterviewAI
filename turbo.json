{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": ["LOCALAPPDATA", "GOPATH", "GOROOT", "GOCACHE", "GOMODCACHE", "HOME"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "passThroughEnv": ["GOPATH", "GOROOT", "GOCACHE", "LOCALAPPDATA", "PATH", "HOME"]
    },
    "dev#landing": {
      "cache": false,
      "persistent": true
    },
    "build#landing": {
      "outputs": ["apps/landing/dist/**"]
    }
  }
}
