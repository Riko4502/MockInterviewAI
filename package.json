{
  "name": "mock-interview-ai",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=web",
    "dev:landing": "turbo dev --filter=landing",
    "dev:realtime": "turbo dev --filter=@apps/realtime",
    "dev:api": "turbo dev --filter=api",
    "generate:api": "pnpm --filter api generate:openapi",
    "storybook": "pnpm --filter=ui-docs storybook",
    "dev:storybook": "pnpm --filter=ui-docs storybook",
    "build:web": "turbo build --filter=web",
    "build:landing": "turbo build --filter=landing",
    "build:realtime": "turbo build --filter=@apps/realtime",
    "build:api": "turbo build --filter=api",
    "build:storybook": "pnpm --filter=ui-docs build-storybook",
    "lint": "biome check --no-errors-on-unmatched",
    "format": "biome format --write --no-errors-on-unmatched",
    "lint:fix": "biome check --write --no-errors-on-unmatched",
    "lint:realtime": "pnpm --filter=@apps/realtime lint",
    "lint:api": "pnpm --filter api lint",
    "test": "turbo test",
    "test:web": "pnpm --filter=web test",
    "test:landing": "pnpm --filter=landing test",
    "test:storybook": "pnpm --filter=ui-docs test",
    "test:realtime": "pnpm --filter=@apps/realtime test",
    "test:api": "pnpm --filter api test",
    "infra:up": "docker compose --env-file .env up -d",
    "infra:down": "docker compose --env-file .env down",
    "db:migrate": "pnpm --filter api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter api db:migrate:deploy",
    "db:generate": "pnpm --filter api db:generate",
    "vercel-ignore:ui-docs": "bash scripts/vercel-ignore-ui-docs.sh",
    "vercel-ignore:landing": "bash scripts/vercel-ignore-landing.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "turbo": "^2.4.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^21.2.2"
  },
  "packageManager": "pnpm@9.15.9"
}
